theorem checkAll_f14 : checkAll 3 f14 certN14 = true := by decide +kernel

/-- `f_14` is irreducible modulo `3` (note §"Irreducibility"). -/
theorem f14_irreducible_mod : Irreducible (toPoly f14 : (ZMod 3)[X]) :=
  have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  irreducible_zmod_of_checkAll 3 f14 certN14 checkAll_f14

/-- The threshold polynomial `f_14` is irreducible over `ℤ` and over `ℚ` (note §"Irreducibility"). -/
theorem f14_irreducible : Irreducible (toPoly f14 : ℤ[X]) ∧ Irreducible (toPoly f14 : ℚ[X]) :=
  irreducible_of_checkAll 3 (by norm_num) f14 certN14 checkAll_f14

