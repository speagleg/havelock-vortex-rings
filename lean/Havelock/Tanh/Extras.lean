    (∀ y, 0 < y → y < 1 → peval f9 y = 0 → y = ξs) ∧
    ∃ x : ℝ, ξs < x ∧ x < 1 ∧
      (∀ m, 1 ≤ m → m ≤ 8 → 0 < aBlock 9 m x ∧ 0 < bBlock 9 m x) ∧
      aBlock 9 4 x * bBlock 9 4 x - gBlock 9 4 x ^ 2 < 0 := by
  obtain ⟨ξs, hta, htb, hf0, huniq, hs⟩ := cert_N9
