import Havelock.Tanh.IrredBasic
import Mathlib.Tactic.NormNum.Prime
import Havelock.Tanh.CertN8

/-! # Irreducibility of `f_8` (note §"Irreducibility")

`f_8` (degree 10) is irreducible modulo `p = 7` (which does not divide its leading coefficient), hence
irreducible over `ℤ` and `ℚ`. Certificate generated by `tanh/irreducibility/lean_irred_gen.py`; it is
checked by `decide +kernel` against `Havelock.Tanh.Irred.checkAll`. -/

namespace Havelock.Tanh.Irred

open Polynomial

/-- Certificate for `f_8` modulo `7`. -/
def certN8 : Cert where
  q0 := []
  m1 := [0, 0, 0, 0, 0, 0, 0, 1]
  tab := [
    ([6, 5, 3, 6, 1, 3, 5, 0, 1],
      [1, 0, 6, 5, 1]),
    ([6, 0, 6, 1, 4, 1, 1, 6, 0, 3],
      [1, 5, 0, 4, 5, 1]),
    ([6, 4, 4, 2, 6, 2, 4, 1, 3, 2],
      [1, 1, 3, 3, 3, 1, 3]),
    ([2, 3, 6, 2, 1, 2, 2, 4, 0, 4],
      [5, 1, 2, 6, 0, 6, 2]),
    ([1, 0, 3, 5, 5, 2, 1, 3, 1, 2],
      [6, 2, 5, 1, 0, 6, 4]),
    ([2, 3, 2, 6, 6, 4, 1, 2],
      [5, 1, 6, 1, 6, 4, 2]),
    ([1, 5, 4, 2, 5, 0, 0, 4, 4, 6],
      [6, 4, 0, 4, 2]),
    ([5, 1, 5, 2, 0, 2, 2, 0, 3, 1],
      [2, 2, 2, 2, 4, 6, 6])]
  chain := [
    ([0, 0, 0, 0, 0, 0, 0, 1],
      [1, 2, 4, 0, 5, 0, 3],
      [4, 6, 2, 0, 5, 6, 3, 1, 1, 4]),
    ([2, 3, 2, 6, 6, 4, 1, 2],
      [4, 6, 2, 5, 2, 6, 2],
      [2, 5, 4, 1, 4, 2, 1, 1, 6, 6]),
    ([1, 3, 6, 6, 6, 0, 2, 5, 0, 6],
      [3, 2, 2, 3, 5, 1, 6, 3, 3],
      [5, 3, 6, 6, 6, 0, 3, 0, 2, 3]),
    ([4, 5, 5, 1, 1, 2, 2, 5, 2, 5],
      [0, 2, 5, 5, 5, 0, 1, 6],
      [2, 1, 3, 3, 1, 1, 5, 6, 3]),
    ([5, 2, 2, 0, 4, 0, 2, 2, 5, 6],
      [4, 4, 0, 2, 1, 5, 5, 0, 6],
      [5, 5, 4, 0, 2, 1, 5, 5, 0, 6])]
  i := 0
  j := 1

theorem checkAll_f8 : checkAll 7 f8 certN8 = true := by decide +kernel

/-- `f_8` is irreducible modulo `7` (note §"Irreducibility"). -/
theorem f8_irreducible_mod : Irreducible (toPoly f8 : (ZMod 7)[X]) :=
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  irreducible_zmod_of_checkAll 7 f8 certN8 checkAll_f8

/-- The threshold polynomial `f_8` is irreducible over `ℤ` and over `ℚ` (note §"Irreducibility"). -/
theorem f8_irreducible : Irreducible (toPoly f8 : ℤ[X]) ∧ Irreducible (toPoly f8 : ℚ[X]) :=
  irreducible_of_checkAll 7 (by norm_num) f8 certN8 checkAll_f8

end Havelock.Tanh.Irred
