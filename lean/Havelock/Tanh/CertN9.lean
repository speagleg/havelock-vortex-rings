  unfold bBlock W
  simp only [show (9 - 4 : ℕ) = 5 by norm_num, show (2 * 9 - 4 : ℕ) = 14 by norm_num, show (9 + 4 : ℕ) = 13 by norm_num, show (9 - 4 + 9 : ℕ) = 14 by norm_num, show (4 + 9 : ℕ) = 13 by norm_num, show (9 + 9 : ℕ) = 18 by norm_num]
