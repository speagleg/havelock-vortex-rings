theorem N9_linkA4 (x : ℝ) (h0 : 0 < x) (h1 : x < 1) :
    aBlock 9 4 x * (2 * (1 - x) ^ 2 * (1 - x ^ 9) ^ 2) = (1 - x) ^ 4 * peval [-4, 24, 80, 160, 224, 259, 306, 361, 420, 361, 306, 259, 224, 160, 80, 24, -4] x := by
