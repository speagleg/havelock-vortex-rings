theorem N13_A6_pos (x : ℝ) (h0 : 0 < x) (h1 : x < 1) (hf : peval f13 x < 0) :
    0 < aBlock 13 6 x := by
  have h1x : (0 : ℝ) < 1 - x := sub_pos.mpr h1
