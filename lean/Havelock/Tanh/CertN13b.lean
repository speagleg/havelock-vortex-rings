  have hX : (0 : ℝ) < 1 - x ^ 13 := sub_pos.mpr (pow_lt_one₀ h0.le h1 (by norm_num))
  have hn : (1 - x) ^ 4 * peval [-18, 12, 86, 200, 350, 532, 664, 729, 814, 915, 1028, 1149, 1274, 1149, 1028, 915, 814, 729, 664, 532, 350, 200, 86, 12, -18] x < 0 := by
