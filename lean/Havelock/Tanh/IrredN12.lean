/-- `f_12` is irreducible modulo `11` (note §"Irreducibility"). -/
theorem f12_irreducible_mod : Irreducible (toPoly f12 : (ZMod 11)[X]) :=
  have : Fact (Nat.Prime 11) := ⟨by norm_num⟩
  irreducible_zmod_of_checkAll 11 f12 certN12 checkAll_f12

/-- The threshold polynomial `f_12` is irreducible over `ℤ` and over `ℚ` (note §"Irreducibility"). -/
theorem f12_irreducible : Irreducible (toPoly f12 : ℤ[X]) ∧ Irreducible (toPoly f12 : ℚ[X]) :=
  irreducible_of_checkAll 11 (by norm_num) f12 certN12 checkAll_f12

